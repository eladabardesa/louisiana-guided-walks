generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TourType {
  REGULAR
  FAMILIES_COUPLES
  TEAMBUILDING
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  MOBILEPAY
}

model Submission {
  id             String   @id @default(cuid())
  selectedDate   String
  ticketQuantity Int      @default(1)
  fullName       String
  email          String
  phone          String
  note           String?
  newsletter     Boolean  @default(false)
  venue          String?
  tourType       String?
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([selectedDate])
  @@index([venue])
}

model Venue {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String
  tagline     String
  description String
  heroImage   String
  images      Json     @default("[]")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tours Tour[]

  @@index([isActive])
  @@index([sortOrder])
}

model Tour {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  tourType    TourType
  price       Int      @default(0)
  capacity    Int?
  isActive    Boolean  @default(true)
  isB2B       Boolean  @default(false)
  heroImage   String?
  images      Json     @default("[]")
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dates  TourDate[]
  orders Order[]

  @@index([tourType])
  @@index([isActive])
  @@index([venueId])
}

model TourDate {
  id        String   @id @default(cuid())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  label     String?
  language  String?
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([tourId])
  @@index([startsAt])
  @@index([isActive])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  tourId          String
  tour            Tour           @relation(fields: [tourId], references: [id])
  tourDateId      String?
  tourDate        TourDate?      @relation(fields: [tourDateId], references: [id], onDelete: SetNull)
  quantity        Int            @default(1)
  totalAmount     Int
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod?
  fullName        String
  email           String
  phone           String
  note            String?
  newsletter      Boolean        @default(false)
  paymentIntentId String?
  mobilepayId     String?
  customDate      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orderNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([tourId])
  @@index([tourDateId])
}
